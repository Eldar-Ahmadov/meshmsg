[
  ["eval", "document.querySelector('[data-readout]').textContent"],
  ["click", "#step"], ["click", "#step"],
  ["eval", "if(!document.querySelector('#step').disabled||document.querySelector('#accept').disabled) throw Error('should wait for consent'); if(document.querySelector('#m-bytes').textContent!=='0 B') throw Error('bytes moved before consent'); 'consent gate passed'"],
  ["click", "#accept"],
  ["until", "document.querySelector('[data-readout]').textContent.startsWith('Installed')", 15000],
  ["eval", "const m=['#m-bytes','#m-blocks','#m-events'].map(s=>document.querySelector(s).textContent).join(' | '); if(m!=='240 MiB | 15,360 | 30') throw Error(m); m"],
  ["lines"],
  ["click", "#dest"], ["click", "#accept"],
  ["until", "document.querySelector('[data-readout]').textContent.startsWith('download_failed')", 8000],
  ["eval", "if(document.querySelector('#m-bytes').textContent!=='0 B'||!document.querySelector('#status').textContent.includes('already exists')) throw Error('dest'); 'no-clobber passed'"],
  ["click", "#dest"], ["click", "#tamper"], ["click", "#accept"],
  ["until", "document.querySelector('[data-readout]').textContent.startsWith('download_failed')", 15000],
  ["eval", "if(!document.querySelector('#status').textContent.includes('BLAKE3')||document.querySelector('[data-step=install]').dataset.state!=='never') throw Error('tamper'); 'tamper passed: '+document.querySelector('#m-bytes').textContent"],
  ["lines"],
  ["click", "#tamper"], ["click", "#provider"], ["click", "#dedup"], ["click", "#accept"],
  ["until", "document.querySelector('[data-readout]').textContent.startsWith('Installed')", 15000],
  ["eval", "if(document.querySelector('#m-bytes').textContent!=='0 B'||document.querySelector('[data-step=stream]').dataset.state!=='skip') throw Error('dedup'); 'dedup offline passed'"],
  ["click", "#dedup"], ["click", "#accept"],
  ["until", "document.querySelector('[data-readout]').textContent.startsWith('download_failed')", 15000],
  ["eval", "if(!document.querySelector('#status').textContent.includes('offline')) throw Error('offline'); 'offline passed'"],
  ["click", "#provider"],
  ["eval", "const l=document.querySelector('#limit'); l.value='small'; l.dispatchEvent(new Event('change')); document.querySelector('#accept').click(); 'limit set'"],
  ["until", "document.querySelector('[data-readout]').textContent.startsWith('download_failed')", 8000],
  ["eval", "if(!document.querySelector('#status').textContent.includes('limit')) throw Error('limit'); if(document.documentElement.scrollWidth>innerWidth) throw Error('overflow'); 'limit passed'"],
  ["shot", "/tmp/fs-checked.png", "main", 1]
]
